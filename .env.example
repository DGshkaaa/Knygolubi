APP_NAME=Knigoluby
ENVIRONMENT=development
MONGODB_URL=mongodb://localhost:27017
MONGODB_DATABASE=knigoluby
JWT_SECRET=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Render Free: use Brevo HTTPS API, SMTP ports 25/465/587 are blocked.
# Verify EMAIL_FROM_EMAIL as a sender in Brevo before sending.
BREVO_API_KEY=
EMAIL_FROM_EMAIL=
EMAIL_FROM_NAME=Книголюби
# On Render set FRONTEND_URL=https://knygolubi-1.onrender.com

# SMTP is used only when BREVO_API_KEY is empty (e.g. local development).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-gmail-address@gmail.com
SMTP_PASSWORD=your-google-app-password
SMTP_FROM_EMAIL=your-gmail-address@gmail.com
SMTP_USE_SSL=false
FRONTEND_URL=http://localhost:5173
